# ── LLM API 配置 ──
# 主模型（对话/推理），任意 OpenAI 兼容接口
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-pro

# 轻量模型（意图提取/摘要等内部操作）
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_FLASH_API_KEY=your_api_key_here
DEEPSEEK_FLASH_API_URL=https://api.deepseek.com/v1/chat/completions

# 视觉模型（截屏/摄像头图像分析，可留空禁用视觉工具）
GLM_API_KEY=
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_MODEL=glm-4v-flash

# ── 身份配置（persona，所有提示词占位符从此取值）──
# 用户称呼（提示词中 {user_name} 的取值）
PERSONA_USER_NAME=用户
# AI 名字（提示词中 {ai_name} 的取值）
PERSONA_AI_NAME=AI

# ── 硅基感知（silicon_perception，均可留空降级）──
# 天气监控城市（留空跳过天气采集）
WEATHER_CITY=
# 高德地图 API Key（GPS 逆地理编码 + 天气定位；留空则只显坐标）
# 申请：https://lbs.amap.com/ （Web服务 API）
AMAP_API_KEY=
# 心率设备蓝牙 MAC（任意 0x180D 标准 BLE 心率设备；留空禁用心率采集）
HR_DEVICE_MAC=

# ── 搜索（web_search 工具）──
# 留空用内置免费引擎(Sogou/360)；填 tavily + key 走 Tavily API
SEARCH_PROVIDER=builtin
TAVILY_API_KEY=

# ── 漫想小红书（部署者自己的设备；不提供设备/账号信息）──
MIRROW_XHS_ADB_SERIAL=
# 可选关系时间线事实；空白不注入任何相识日期或经历
PERSONA_TIMELINE_ANCHOR=
# 可选群组参与者显示名 JSON；群组上下文还须宿主传入 host_group_room_id
PERSONA_GROUP_SENDER_LABELS=
# 留空使用系统临时目录中的跨进程设备租约
MIRROW_ANDROID_LEASE_DIR=
# 可选公共页面入口；留空时请移除此变量，使用模块默认推荐页
# MIRROW_XHS_PUBLIC_FEED_URL=https://www.xiaohongshu.com/explore
